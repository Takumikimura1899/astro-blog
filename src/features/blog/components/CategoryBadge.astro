---
import type { Category } from "../types";
import type { BLOG_CATEGORIES } from "@/config/blog";

type Props = Category;
const { name } = Astro.props;
if (!name) {
	return;
}

const CATEGORY_COLORS: Record<(typeof BLOG_CATEGORIES)[number], string> = {
	JavaScript: "bg-amber-500 dark:bg-amber-600",
	React: "bg-amber-500 dark:bg-amber-600",
	"Next.js": "bg-amber-500 dark:bg-amber-600",
	TypeScript: "bg-amber-500 dark:bg-amber-600",
	TailwindCSS: "bg-amber-500 dark:bg-amber-600",
	"Node.js": "bg-blue-600 dark:bg-blue-500",
	"Nest.js": "bg-blue-600 dark:bg-blue-500",
	Prisma: "bg-blue-600 dark:bg-blue-500",
	Go: "bg-blue-600 dark:bg-blue-500",
	Github: "bg-emerald-500 dark:bg-emerald-600",
	Git: "bg-emerald-500 dark:bg-emerald-600",
	Docker: "bg-emerald-500 dark:bg-emerald-600",
	Cloudflare: "bg-emerald-500 dark:bg-emerald-600",
	日記: "bg-gray-500 dark:bg-gray-600",
};
---

<div class={`inline-block px-2 py-1 rounded text-white text-xs ${CATEGORY_COLORS[name]}`}>
  {name}
</div>
