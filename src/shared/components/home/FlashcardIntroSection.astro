---
import type { Deck } from "@/features/flashcard/types";

interface Props {
	decks: Deck[];
}

const { decks } = Astro.props;
const displayDecks = decks.slice(0, 2);
---

<section class="py-12">
  <div class="flex justify-between items-center mb-8">
    <div>
      <h2 class="text-2xl font-bold mb-2">フラッシュカードで学習</h2>
      <p class="text-muted-foreground">
        インタラクティブなカードで効率的に学習できます
      </p>
    </div>
    <a
      href="/flashcards"
      class="text-primary hover:underline font-medium no-underline"
    >
      すべて見る &rarr;
    </a>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {displayDecks.map((deck) => (
      <a href={`/flashcards/${deck.id}`} class="group block no-underline hover:no-underline">
        <article class="h-full p-6 bg-card border rounded-xl shadow-sm hover:shadow-md transition-all duration-300 hover:border-primary">
          <h3 class="text-xl font-bold mb-2 group-hover:text-primary transition-colors">
            {deck.title}
          </h3>
          <p class="text-muted-foreground mb-4 text-sm">
            {deck.cards.length} cards
          </p>
          <p class="text-sm text-foreground/80 line-clamp-2">
            {deck.description || "説明はありません"}
          </p>
        </article>
      </a>
    ))}
  </div>
</section>
