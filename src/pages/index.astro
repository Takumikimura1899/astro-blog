---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeroSection from "@/shared/components/home/HeroSection.astro";
import LatestBlogsSection from "@/shared/components/home/LatestBlogsSection.astro";
import FlashcardIntroSection from "@/shared/components/home/FlashcardIntroSection.astro";
import { getLatestBlogs } from "@/lib/microcms";
import { getAllDecks } from "@/data/flashcards";

const blogs = await getLatestBlogs(3);
const decks = getAllDecks();
---

<BaseLayout>
  <main>
    <HeroSection />
    <LatestBlogsSection blogs={blogs} />
    <FlashcardIntroSection decks={decks} />
  </main>
</BaseLayout>
