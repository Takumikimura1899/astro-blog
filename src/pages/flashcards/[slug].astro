---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { FlashcardPlayer } from "@/features/flashcard/components/FlashcardPlayer";
import { getAllDecks } from "@/data/flashcards";

export async function getStaticPaths() {
	const decks = getAllDecks();
	return decks.map((deck) => ({
		params: { slug: deck.id },
		props: { deck },
	}));
}

const { deck } = Astro.props;
---

<BaseLayout>
  <main>
    <div class="mb-8">
        <a href="/flashcards" class="text-sm text-muted-foreground hover:text-foreground mb-4 inline-block no-underline">
            ← 一覧に戻る
        </a>
        <h1 class="text-2xl font-bold">{deck.title}</h1>
    </div>
    <FlashcardPlayer client:load deck={deck} />
  </main>
</BaseLayout>
